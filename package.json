{
  "name": "worktree-ci-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Parallel Claude worktrees with a CI gate protecting main",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\"",
    "test:smoke": "node tests/verify-app.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  }
}
